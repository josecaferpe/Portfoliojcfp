# --- CREDENCIALES TELEGRAM ---
TELEGRAM_TOKEN=TOKEN_PERSONAL
TELEGRAM_CHAT_ID=TOKEN_CHAT

# --- AMADEUS API (OAUTH2) ---
# Regístrate en https://developers.amadeus.com/ para obtenerlas
AMADEUS_CLIENT_ID=client_id_de_amadeus
AMADEUS_CLIENT_SECRET=client_secret_de_amadeus

# --- CONFIGURACIÓN DEL VIAJE ---
# Códigos IATA (ej: MAD = Madrid, JFK = Nueva York, TYO = Tokyo)
ORIGIN=MAD
DESTINATION=JFK

# Fecha de salida (Formato AAAA-MM-DD)
DEPARTURE_DATE=2026-12-25

# --- ALERTA DE PRECIO ---
# El bot solo notifica si encuentra un vuelo por DEBAJO de este precio (Euros)
MAX_PRICE=600
